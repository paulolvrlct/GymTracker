    "run.phase.base.advice": {
      "comment": "Plans d'entrainement",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build volume and keep the easy runs genuinely easy: that's what lets you absorb the harder weeks later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye volumen y mantén los rodajes realmente suaves: es lo que te permitirá asimilar las semanas duras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construis le volume et garde l'endurance vraiment facile : c'est ce qui te permettra d'encaisser la suite."
          }
        }
      }
    },
    "run.phase.development": {
      "comment": "Plans d'entrainement",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desarrollo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développement"
          }
        }
      }
    },
    "run.phase.development.advice": {
      "comment": "Plans d'entrainement",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hardest block: this is where you raise your ceiling. Recover properly between intervals, walking if you need to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloque más exigente: aquí subes tu techo. Recupera de verdad entre series, andando si hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La partie la plus exigeante : on développe la VMA. Récupère vraiment entre les fractions, quitte à marcher."
          }
        }
      }
    },
    "run.phase.specific": {
      "comment": "Plans d'entrainement",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Race specific"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Específico"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spécifique"
          }
        }
      }
    },
    "run.phase.specific.advice": {
      "comment": "Plans d'entrainement",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now you settle into race pace. Learn to recognise it without looking at your watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora asientas el ritmo de carrera. Aprende a reconocerlo sin mirar el reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On installe l'allure du jour J. Apprends à la reconnaître sans regarder ta montre."
          }
        }
      }
    },
    "run.phase.taper": {
      "comment": "Plans d'entrainement",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taper"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puesta a punto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affûtage"
          }
        }
      }
    },
    "run.phase.taper.advice": {
      "comment": "Plans d'entrainement",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume drops, a little speed stays. Don't try to make up missed work: it's too late, and it costs you on race day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el volumen y se mantiene algo de velocidad. No intentes recuperar el trabajo perdido: ya es tarde y sale caro el día de la carrera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On réduit le volume en gardant un peu de vitesse. Ne cherche pas à rattraper le travail non fait : c'est trop tard, et ça coûte cher le jour de la course."
          }
        }
      }
    },
    "run.session.easy": {
