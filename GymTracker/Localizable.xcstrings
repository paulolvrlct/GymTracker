    "Tes aliments déjà consommés apparaîtront ici pour un ajout en un tap.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Foods you've already eaten will show up here so you can add them in one tap."
          }
        },
