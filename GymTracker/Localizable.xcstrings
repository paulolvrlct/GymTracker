    "run.phase.base": {
      "comment": "Plans d'entrainement",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Base"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Base"
          }
        },
        "fr": {
