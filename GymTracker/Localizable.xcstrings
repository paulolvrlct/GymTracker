    },
    "Tes jambes travaillent : ça fait des kilomètres, ce mois-ci.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your legs are working: that's a good few kilometres this month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus piernas trabajan: llevas unos cuantos kilómetros este mes."
          }
        }
      }
    },
    "Tes points sont recalculés depuis ton historique. Ils restent donc justes, même si tu supprimes une séance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your points are recalculated from your history, so they stay accurate even if you delete a workout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus puntos se recalculan a partir de tu historial, así que siguen siendo exactos aunque borres un entreno."
          }
        }
      }
    },
