    "Ta séance n'a pas pu être sauvegardée. Vérifie l'espace de stockage puis réessaie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your workout couldn't be saved. Check your storage space and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar tu entreno. Comprueba el espacio de almacenamiento e inténtalo de nuevo."
          }
        }
      }
    },
