{
  "sourceLanguage": "fr",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Affiché à la demande d'accès caméra (scan de code-barres).",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftRun utilise la caméra pour scanner le code-barres de tes produits et récupérer automatiquement leurs valeurs nutritionnelles."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftRun uses the camera to scan your products' barcodes and fetch their nutrition values automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftRun usa la cámara para escanear el código de barras de tus productos y obtener automáticamente sus valores nutricionales."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "comment": "Affiché à la demande de lecture dans Apple Santé.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftRun lit ton poids pour pré-remplir ton profil et, si tu l'actives, tes entraînements (montre, autres apps), ton sommeil et ta variabilité cardiaque pour calculer ta forme du jour. Ces données restent sur ton appareil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftRun reads your weight to prefill your profile and, if you turn it on, your workouts (watch, other apps), sleep and heart rate variability to work out your daily readiness. This data stays on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftRun lee tu peso para rellenar tu perfil y, si lo activas, tus entrenamientos (reloj, otras apps), tu sueño y tu variabilidad cardíaca para calcular tu forma del día. Estos datos se quedan en tu dispositivo."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "Affiché à la demande d'écriture dans Apple Santé.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftRun enregistre tes séances, tes courses et ta nutrition dans Apple Santé."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftRun saves your workouts, runs and nutrition to Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftRun guarda tus entrenos, tus carreras y tu nutrición en Apple Salud."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Affiché à la demande d'accès GPS pendant une course.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftRun suit ta position pour enregistrer ton allure et ton tracé pendant tes courses."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftRun tracks your location to record your pace and route while you run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftRun sigue tu ubicación para registrar tu ritmo y tu ruta mientras corres."
          }
        }
      }
    }
  },
  "version": "1.0"
}
