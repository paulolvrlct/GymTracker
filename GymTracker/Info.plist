<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Langues supportées, déclarées explicitement. Sans cette clé, iOS n'expose
	     pas le sélecteur « Langue » dans Réglages › Apps › LiftRun, et l'App Store
	     n'annonce pas les langues sur la fiche produit. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
		<string>en</string>
		<string>es</string>
	</array>
	<key>NSHealthUpdateUsageDescription</key>
	<string>LiftRun enregistre tes séances, tes courses et ta nutrition dans Apple Santé.</string>
	<key>NSCameraUsageDescription</key>
	<string>LiftRun utilise la caméra pour scanner le code-barres de tes produits et récupérer automatiquement leurs valeurs nutritionnelles.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>LiftRun lit ton poids depuis Apple Santé pour pré-remplir ton profil, uniquement quand tu le demandes.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
